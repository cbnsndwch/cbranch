    "identifier": "dev.cbranch.desktop.canary",
    "bundle": {
        "icon": [
            "icons/canary/32x32.png",
            "icons/canary/128x128.png",
            "icons/canary/128x128@2x.png",
            "icons/canary/icon.icns",
            "icons/canary/icon.ico"
        ],
