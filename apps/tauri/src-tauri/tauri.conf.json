{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "cbranch",
    "version": "0.2.4",
    "identifier": "com.cbranch.desktop",
    "build": {
        "beforeDevCommand": "pnpm -w ensure:server-bundle && pnpm --filter @cbranch/ui dev",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "pnpm -w ensure:server-bundle && pnpm -w build:libs && pnpm --filter @cbranch/ui build",
        "frontendDist": "../../../packages/ui/build/client"
    },
    "app": {
        "windows": [
            {
                "title": "cBranch",
                "width": 1280,
                "height": 800,
                "minWidth": 960,
                "minHeight": 640,
                "resizable": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'"
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "createUpdaterArtifacts": true,
        "publisher": "cbranch",
        "resources": {
            "resources/cbranch-server.tar.gz": "cbranch-server.tar.gz"
        },
        "windows": {
            "nsis": {
                "installMode": "currentUser",
                "displayLanguageSelector": true
            }
        },
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENENTQ0RTEzQTNCOTZFOTkKUldTWmJybWpFMDVVelEvaXlMSWpLMXRJRU9BK0JoZlZiVzZZMVpwV0ZLckdTY2lwZTJmNjJJYnkK",
            "endpoints": [
                "https://github.com/cbnsndwch/cbranch/releases/latest/download/latest.json"
            ]
        }
    }
}
