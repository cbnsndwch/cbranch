{
    "name": "@cbranch/tauri",
    "version": "0.1.1",
    "private": true,
    "description": "Tauri desktop client for cbranch over SSH local forwarding.",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "pnpm -w build:libs && pnpm --filter @cbranch/ui build",
        "dev": "pnpm -w package:server-bundle && tauri dev",
        "tauri": "tauri",
        "tauri:build": "pnpm -w package:server-bundle && tauri build --bundles nsis",
        "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml",
        "tauri:test": "cargo test --manifest-path src-tauri/Cargo.toml",
        "tauri:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check"
    },
    "dependencies": {
        "@cbranch/ui": "workspace:*"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.11.4"
    }
}
